# Copy this file's contents into Railway's "Variables" tab for your service
# (or a local .env file for development). Never commit real values to git.

# --- Database (Railway injects this automatically if you add a Postgres plugin) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Garmin Connect (required) ---
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
GARMIN_TOKEN_STORE=/data/.garminconnect
GARMIN_SYNC_DAYS_BACK=14

# --- TrainingPeaks (optional, off by default -- see trainingpeaks_sync.py) ---
TP_AUTOMATED_SYNC_ENABLED=false
TP_COOKIE=

# --- Dashboard login (this is a personal single-user tool) ---
APP_USERNAME=athlete
APP_PASSWORD=choose-a-real-password

# --- Strength plan ---
STRENGTH_SESSIONS_PER_WEEK=3
# Optional: only needed if you want the backend to auto-call Claude for the
# weekly AI review step instead of pasting the prompt manually.
ANTHROPIC_API_KEY=

APP_SECRET=change-me-to-something-random
